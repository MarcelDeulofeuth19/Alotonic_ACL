# Conexión a la base legacy alocreditprod (mismos nombres que usa AloTonic:
# copiar los valores del .env de AloTonic).
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DB=alocreditprod
# SSL opt-in (igual que el cliente actual)
MYSQL_SSL_ENABLED=false
MYSQL_SSL_CA=

# Claves de API de los consumidores, separadas por coma. Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Sin claves configuradas el servicio rechaza TODO (nunca arranca abierto).
ACL_API_KEYS=
